{
  "version": "1.0",
  "sources": [
    "../../examples/spec/native-weather.smithy",
    "../spitzeisen-smithy-codegen/src/test/resources/policy-features.smithy"
  ],
  "projections": {
    "weather": {
      "transforms": [
        {
          "name": "includeServices",
          "args": {
            "services": [
              "native.weather#WeatherService"
            ]
          }
        },
        {
          "name": "removeUnusedShapes"
        }
      ],
      "plugins": {
        "spitzeisen-python-client-codegen": {
          "service": "native.weather#WeatherService",
          "package": "weather_sdk",
          "client_name": "Client"
        }
      }
    },
    "policy": {
      "transforms": [
        {
          "name": "includeServices",
          "args": {
            "services": [
              "policy.example#ExampleService"
            ]
          }
        },
        {
          "name": "removeUnusedShapes"
        }
      ],
      "plugins": {
        "spitzeisen-python-client-codegen": {
          "service": "policy.example#ExampleService",
          "package": "policy_sdk",
          "client_name": "Client",
          "python": {
            "input_adapters": {
              "date": {
                "function": {
                  "module": "spitzeisen",
                  "name": "coerce_date"
                },
                "public_type": {
                  "kind": "date_input"
                }
              },
              "comma-list": {
                "function": {
                  "module": "policy_sdk.adapters",
                  "name": "join_values"
                },
                "public_type": {
                  "kind": "list",
                  "members": [
                    {
                      "kind": "str"
                    }
                  ]
                }
              },
              "custom": {
                "function": {
                  "module": "policy_sdk.adapters",
                  "name": "custom"
                },
                "public_type": {
                  "kind": "str"
                }
              }
            }
          }
        }
      }
    }
  }
}
