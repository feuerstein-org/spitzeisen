{
  "version": "1.0",
  "sources": ["model"],
  "maven": {
    "dependencies": [
      "software.amazon.smithy:smithy-model:[1.73.0,2.0)",
      "software.amazon.smithy:smithy-aws-traits:[1.73.0,2.0)",
      "software.amazon.smithy.python.codegen:core:0.5.0"
    ]
  },
  "projections": {
    "client": {
      "plugins": {
        "python-client-codegen": {
          "service": "test.spitzeisen.weather#WeatherService",
          "module": "smithy_weather_sdk",
          "moduleVersion": "0.0.1"
        }
      }
    }
  }
}
