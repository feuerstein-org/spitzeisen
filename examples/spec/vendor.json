{
  "openapi": "3.1.0",
  "info": {
    "title": "OpenWeather Current Weather API",
    "description": "An OpenAPI transcription of OpenWeather's official Current Weather documentation.",
    "version": "2.5"
  },
  "externalDocs": {
    "description": "Official Current Weather documentation",
    "url": "https://openweathermap.org/api/current?collection=current_forecast"
  },
  "servers": [
    {
      "url": "https://api.openweathermap.org"
    }
  ],
  "paths": {
    "/data/2.5/weather": {
      "get": {
        "operationId": "getCurrentWeather",
        "summary": "Current weather by geographic coordinates",
        "description": "Returns the current weather observation for one latitude and longitude.",
        "parameters": [
          {
            "name": "lat",
            "in": "query",
            "required": true,
            "description": "Latitude of the location.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "lon",
            "in": "query",
            "required": true,
            "description": "Longitude of the location.",
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "description": "Optional non-JSON response format. JSON is returned when omitted.",
            "schema": {
              "type": "string",
              "enum": [
                "xml",
                "html"
              ]
            }
          },
          {
            "name": "units",
            "in": "query",
            "required": false,
            "description": "Units of measurement. Standard units are used by default.",
            "schema": {
              "type": "string",
              "enum": [
                "standard",
                "metric",
                "imperial"
              ],
              "default": "standard"
            }
          },
          {
            "name": "lang",
            "in": "query",
            "required": false,
            "description": "Language code used for the city name and weather description.",
            "schema": {
              "type": "string"
            }
          }
        ],
        "security": [
          {
            "ApiKeyAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "Current weather observation.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentWeatherResponse"
                }
              }
            }
          },
          "401": {
            "description": "The API key is missing or invalid."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "query",
        "name": "appid"
      }
    },
    "schemas": {
      "Coordinates": {
        "type": "object",
        "properties": {
          "lon": {
            "type": "number",
            "description": "Longitude of the location."
          },
          "lat": {
            "type": "number",
            "description": "Latitude of the location."
          }
        }
      },
      "WeatherCondition": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "description": "Weather condition identifier."
          },
          "main": {
            "type": "string",
            "description": "Weather condition group, such as Rain, Snow, or Clouds."
          },
          "description": {
            "type": "string",
            "description": "Weather condition within the group."
          },
          "icon": {
            "type": "string",
            "description": "Weather icon identifier."
          }
        }
      },
      "WeatherMeasurements": {
        "type": "object",
        "properties": {
          "temp": {
            "type": "number",
            "description": "Current temperature."
          },
          "feels_like": {
            "type": "number",
            "description": "Temperature adjusted for human perception."
          },
          "temp_min": {
            "type": "number",
            "description": "Optional minimum currently observed temperature within the location."
          },
          "temp_max": {
            "type": "number",
            "description": "Optional maximum currently observed temperature within the location."
          },
          "pressure": {
            "type": "integer",
            "description": "Atmospheric pressure at sea level in hPa."
          },
          "humidity": {
            "type": "integer",
            "description": "Humidity percentage."
          },
          "sea_level": {
            "type": "integer",
            "description": "Atmospheric pressure at sea level in hPa, where available."
          },
          "grnd_level": {
            "type": "integer",
            "description": "Atmospheric pressure at ground level in hPa, where available."
          }
        }
      },
      "Wind": {
        "type": "object",
        "properties": {
          "speed": {
            "type": "number",
            "description": "Wind speed in units selected by the request."
          },
          "deg": {
            "type": "integer",
            "description": "Meteorological wind direction in degrees."
          },
          "gust": {
            "type": "number",
            "description": "Wind gust speed, where available."
          }
        }
      },
      "PrecipitationVolume": {
        "type": "object",
        "properties": {
          "1h": {
            "type": "number",
            "description": "Precipitation volume for the preceding hour in mm/h."
          }
        }
      },
      "Clouds": {
        "type": "object",
        "properties": {
          "all": {
            "type": "integer",
            "description": "Cloudiness percentage."
          }
        }
      },
      "SystemMetadata": {
        "type": "object",
        "properties": {
          "type": {
            "type": "integer",
            "description": "Internal parameter."
          },
          "id": {
            "type": "integer",
            "description": "Internal parameter."
          },
          "message": {
            "type": "number",
            "description": "Internal parameter present in some responses."
          },
          "country": {
            "type": "string",
            "description": "Country code."
          },
          "sunrise": {
            "type": "integer",
            "description": "Sunrise time as a Unix timestamp in UTC."
          },
          "sunset": {
            "type": "integer",
            "description": "Sunset time as a Unix timestamp in UTC."
          }
        }
      },
      "CurrentWeatherResponse": {
        "type": "object",
        "properties": {
          "coord": {
            "$ref": "#/components/schemas/Coordinates"
          },
          "weather": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/WeatherCondition"
            }
          },
          "base": {
            "type": "string",
            "description": "Internal parameter."
          },
          "main": {
            "$ref": "#/components/schemas/WeatherMeasurements"
          },
          "visibility": {
            "type": "integer",
            "description": "Visibility in metres, with a maximum reported value of 10 km."
          },
          "wind": {
            "$ref": "#/components/schemas/Wind"
          },
          "rain": {
            "$ref": "#/components/schemas/PrecipitationVolume"
          },
          "snow": {
            "$ref": "#/components/schemas/PrecipitationVolume"
          },
          "clouds": {
            "$ref": "#/components/schemas/Clouds"
          },
          "dt": {
            "type": "integer",
            "description": "Time of data calculation as a Unix timestamp in UTC."
          },
          "sys": {
            "$ref": "#/components/schemas/SystemMetadata"
          },
          "timezone": {
            "type": "integer",
            "description": "Shift in seconds from UTC."
          },
          "id": {
            "type": "integer",
            "description": "City identifier."
          },
          "name": {
            "type": "string",
            "description": "City name."
          },
          "cod": {
            "type": "integer",
            "description": "Internal response status code."
          }
        }
      }
    }
  }
}
