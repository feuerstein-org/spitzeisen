+package smithytranslate.compiler.openapi
+
+import cats.data.NonEmptyList
+import io.swagger.parser.OpenAPIParser
+import smithytranslate.compiler._
+import software.amazon.smithy.model.Model
+import software.amazon.smithy.model.shapes.ShapeId
+import software.amazon.smithy.model.traits.RangeTrait
+import scala.jdk.CollectionConverters._
+
+final class OpenApi31Spec extends munit.FunSuite {
+  private val options = ToSmithyCompilerOptions(
+    useVerboseNames = false,
+    validateInput = true,
+    validateOutput = true,
+    transformers = Nil,
+    useEnumTraitSyntax = false,
+    debug = false
+  )
+
+  private def input(spec: String): OpenApiCompilerInput =
+    OpenApiCompilerInput.UnparsedSpecs(
+      List(FileContents(NonEmptyList.one("foo.yaml"), spec))
+    )
+
+  private def compile(spec: String): Model =
+    OpenApiCompiler.compile(options, input(spec)) match {
+      case ToSmithyResult.Success(errors, model) =>
+        assertEquals(errors, Nil)
+        model
+      case ToSmithyResult.Failure(error, errors) =>
+        fail((error :: errors).mkString("\n"))
+    }
+
+  private def document(schemas: String, version: String = "3.1.0"): String =
+    s"""openapi: '$version'
+       |info:
+       |  title: Test
+       |  version: '1.0'
+       |paths: {}
+       |components:
+       |  schemas:
+       |${schemas.linesIterator.map("    " + _).mkString("\n")}
+       |""".stripMargin
+
+  private val primitives = List(
+    ("string", "", "string"),
+    ("string", "email", "string"),
+    ("string", "password", "string"),
+    ("string", "uuid", "string"),
+    ("string", "byte", "blob"),
+    ("string", "binary", "blob"),
+    ("string", "date", "string"),
+    ("string", "date-time", "timestamp"),
+    ("string", "timestamp", "timestamp"),
+    ("string", "local-date", "string"),
+    ("string", "local-time", "string"),
+    ("string", "local-date-time", "string"),
+    ("string", "offset-date-time", "timestamp"),
+    ("string", "offset-time", "string"),
+    ("string", "zone-id", "string"),
+    ("string", "zone-offset", "string"),
+    ("string", "zoned-date-time", "string"),
+    ("string", "year-month", "string"),
+    ("string", "month-day", "string"),
+    ("number", "", "double"),
+    ("number", "float", "float"),
+    ("number", "double", "double"),
+    ("number", "duration", "bigDecimal"),
+    ("integer", "", "integer"),
+    ("integer", "int16", "short"),
+    ("integer", "int32", "integer"),
+    ("integer", "int64", "long"),
+    ("integer", "year", "integer"),
+    ("boolean", "", "boolean")
+  )
+
+  primitives.foreach { case (tpe, format, expected) =>
+    test(s"3.1 maps $tpe/$format like 3.0") {
+      val schema = s"Value:\n  type: $tpe\n" +
+        (if (format.isEmpty) "" else s"  format: $format\n")
+      val model31 = compile(document(schema))
+      val model30 = compile(document(schema, "3.0.3"))
+      val value = model31.expectShape(ShapeId.from("foo#Value"))
+      assertEquals(value.getType.toString, expected)
+      assertEquals(ModelWrapper(model31), ModelWrapper(model30))
+    }
+  }
+
+  test(
+    "3.1 preserves collections, enums, references, composition, and data keys"
+  ) {
+    val schemas = """Name:
+                    |  type: string
+                    |  minLength: 1
+                    |  pattern: '^[a-z]+$'
+                    |Item:
+                    |  type: object
+                    |  required: [name]
+                    |  properties:
+                    |    name: {$ref: '#/components/schemas/Name'}
+                    |    const: {type: string}
+                    |    if: {type: boolean}
+                    |  example: {const: one, if: true}
+                    |Names:
+                    |  type: array
+                    |  items: {$ref: '#/components/schemas/Name'}
+                    |  minItems: 1
+                    |UniqueNames:
+                    |  type: array
+                    |  uniqueItems: true
+                    |  items: {type: string}
+                    |Items:
+                    |  type: object
+                    |  additionalProperties: {$ref: '#/components/schemas/Item'}
+                    |Color:
+                    |  type: string
+                    |  enum: [red, blue]
+                    |Free: {type: object}
+                    |Extended:
+                    |  type: object
+                    |  allOf:
+                    |    - {$ref: '#/components/schemas/Item'}
+                    |    - type: object
+                    |      properties:
+                    |        count: {type: integer}
+                    |Choice:
+                    |  oneOf:
+                    |    - {$ref: '#/components/schemas/Item'}
+                    |    - {$ref: '#/components/schemas/Name'}
+                    |""".stripMargin
+    assertEquals(
+      ModelWrapper(compile(document(schemas))),
+      ModelWrapper(compile(document(schemas, "3.0.3")))
+    )
+  }
+
+  test("3.1 HTTP query and response scalars produce a valid model") {
+    val spec = """openapi: '3.1.0'
+                 |info: {title: Test, version: '1.0'}
+                 |paths:
+                 |  /items:
+                 |    get:
+                 |      operationId: getItem
+                 |      parameters:
+                 |        - name: id
+                 |          in: query
+                 |          required: true
+                 |          schema: {type: string}
+                 |      responses:
+                 |        '200':
+                 |          description: OK
+                 |          content:
+                 |            application/json:
+                 |              schema:
+                 |                type: object
+                 |                properties:
+                 |                  name: {type: string}
+                 |                  count: {type: integer}
+                 |                  active: {type: boolean}
+                 |""".stripMargin
+    val model = compile(spec)
+    assertEquals(
+      model
+        .expectShape(ShapeId.from("foo#GetItemInput$id"))
+        .asMemberShape
+        .get
+        .getTarget,
+      ShapeId.from("smithy.api#String")
+    )
+    assertEquals(
+      ModelWrapper(model),
+      ModelWrapper(compile(spec.replace("3.1.0", "3.0.3")))
+    )
+    val parsed = new OpenAPIParser().readContents(spec, null, null).getOpenAPI
+    OpenApiCompiler.compile(
+      options,
+      OpenApiCompilerInput.ParsedSpec(NonEmptyList.one("foo.yaml"), parsed)
+    ) match {
+      case ToSmithyResult.Success(errors, result) =>
+        assertEquals(errors, Nil)
+        assertEquals(ModelWrapper(result), ModelWrapper(model))
+      case other => fail(other.toString)
+    }
+    assertEquals(parsed.getOpenapi, "3.1.0")
+    assertEquals(
+      parsed.getPaths
+        .get("/items")
+        .getGet
+        .getParameters
+        .get(0)
+        .getSchema
+        .getTypes
+        .asScala
+        .toSet,
+      Set("string")
+    )
+  }
+
+  List("[string, 'null']", "['null', string]").foreach { types =>
+    test(s"3.1 nullable $types preserves its scalar and nullable trait") {
+      val model = compile(
+        document(
+          s"Maybe:\n  type: $types\n  minLength: 1\n" +
+            "Holder:\n  type: object\n  required: [value]\n  properties:\n    value: {$ref: '#/components/schemas/Maybe'}"
+        )
+      )
+      val shape = model.expectShape(ShapeId.from("foo#Maybe"))
+      assert(shape.isStringShape)
+      assert(shape.hasTrait("alloy#nullable"))
+      assert(shape.hasTrait("smithy.api#length"))
+      assert(
+        model
+          .expectShape(ShapeId.from("foo#Holder$value"))
+          .hasTrait("smithy.api#required")
+      )
+    }
+  }
+
+  List(true, false).foreach { includesNull =>
+    test(s"3.1 enum nullable trait follows its values: $includesNull") {
+      val values = if (includesNull) "[red, null]" else "[red]"
+      val model =
+        compile(document(s"Color:\n  type: [string, 'null']\n  enum: $values"))
+      val shape = model.expectShape(ShapeId.from("foo#Color"))
+      assert(shape.isEnumShape)
+      assertEquals(shape.hasTrait("alloy#nullable"), includesNull)
+    }
+  }
+
+  test(
+    "3.1 unconstrained and boolean schemas, array items, and nullable collections"
+  ) {
+    val model =
+      compile(document("""Anything: {}
+                         |Holder:
+                         |  type: object
+                         |  properties:
+                         |    always: true
+                         |Values: {type: array}
+                         |ExplicitValues: {type: array, items: {}}
+                         |Object: {type: object, additionalProperties: true}
+                         |DocumentMap: {type: object, additionalProperties: {}}
+                         |Closed:
+                         |  type: object
+                         |  additionalProperties: false
+                         |  properties:
+                         |    name: {type: string}
+                         |MaybeValues:
+                         |  type: [array, 'null']
+                         |  items: {type: integer}
+                         |""".stripMargin))
+    List("Anything", "Object").foreach { name =>
+      assert(model.expectShape(ShapeId.from(s"foo#$name")).isDocumentShape)
+    }
+    List("Values", "ExplicitValues").foreach { name =>
+      val shape = model.expectShape(ShapeId.from(s"foo#$name")).asListShape.get
+      assertEquals(
+        shape.getMember.getTarget,
+        ShapeId.from("smithy.api#Document")
+      )
+    }
+    assert(model.expectShape(ShapeId.from("foo#Closed")).isStructureShape)
+    assert(model.expectShape(ShapeId.from("foo#DocumentMap")).isMapShape)
+    assertEquals(
+      model
+        .expectShape(ShapeId.from("foo#Holder$always"))
+        .asMemberShape
+        .get
+        .getTarget,
+      ShapeId.from("smithy.api#Document")
+    )
+    assert(
+      model
+        .expectShape(ShapeId.from("foo#MaybeValues"))
+        .hasTrait("alloy#nullable")
+    )
+  }
+
+  test("3.1 examples use alloy dataExamples") {
+    val model =
+      compile(document("Name:\n  type: string\n  examples: [first, second]"))
+    val examples = model
+      .expectShape(ShapeId.from("foo#Name"))
+      .findTrait("alloy#dataExamples")
+      .get
+      .toNode
+      .expectArrayNode
+    assertEquals(examples.getElements.size, 2)
+  }
+
+  test("3.1 numeric exclusive bounds combine with inclusive bounds") {
+    val model = compile(document("""Count:
+                                   |  type: integer
+                                   |  minimum: 5
+                                   |  exclusiveMinimum: 3.5
+                                   |  maximum: 20
+                                   |  exclusiveMaximum: 10.5
+                                   |""".stripMargin))
+    val range = model
+      .expectShape(ShapeId.from("foo#Count"))
+      .expectTrait(classOf[RangeTrait])
+    assertEquals(range.getMin.get, new java.math.BigDecimal("5"))
+    assertEquals(range.getMax.get, new java.math.BigDecimal("10"))
+  }
+
+  List(
+    ("exclusiveMinimum: 3\nmaximum: 20", "4", "20"),
+    ("minimum: -5\nexclusiveMaximum: -1.5", "-5", "-2"),
+    ("minimum: 1.5\nmaximum: 4.5", "2", "4"),
+    ("exclusiveMinimum: 3\nexclusiveMaximum: 20", "4", "19")
+  ).foreach { case (bounds, min, max) =>
+    test(s"3.1 integer bounds $bounds") {
+      val model = compile(
+        document(
+          "Count:\n  type: integer\n" + bounds.linesIterator
+            .map("  " + _)
+            .mkString("\n")
+        )
+      )
+      val range = model
+        .expectShape(ShapeId.from("foo#Count"))
+        .expectTrait(classOf[RangeTrait])
+      assertEquals(range.getMin.get, new java.math.BigDecimal(min))
+      assertEquals(range.getMax.get, new java.math.BigDecimal(max))
+    }
+  }
+
+  test("3.0 exclusive maximum is independent of exclusive minimum") {
+    val model = compile(
+      document(
+        "Count:\n  type: integer\n  minimum: 3\n  maximum: 20\n  exclusiveMaximum: true",
+        "3.0.3"
+      )
+    )
+    val range = model
+      .expectShape(ShapeId.from("foo#Count"))
+      .expectTrait(classOf[RangeTrait])
+    assertEquals(range.getMin.get, new java.math.BigDecimal("3"))
+    assertEquals(range.getMax.get, new java.math.BigDecimal("19"))
+  }
+
+  private val unsupported = List(
+    "type: [string, integer]" -> "type",
+    "type: array\nprefixItems: [{type: string}]" -> "prefixItems",
+    "type: object\nunevaluatedProperties: false" -> "unevaluatedProperties",
+    "type: object\nif: {required: [name]}\nthen: {required: [value]}" -> "if",
+    "type: string\nconst: fixed" -> "const",
+    "type: string\nnot: {pattern: '^x'}" -> "not",
+    "type: string\nanyOf: [{minLength: 1}, {maxLength: 5}]" -> "anyOf",
+    "type: integer\nconst: 0" -> "const",
+    "type: string\nconst: null" -> "const",
+    "type: string\nenum: [1, 2]" -> "enum",
+    "type: string\n$ref: '#/components/schemas/Other'" -> "$ref",
+    "type: number\nexclusiveMinimum: 1.5" -> "exclusiveMin/Max",
+    "type: object\n$defs: {Name: {type: string}}" -> "$defs",
+    "type: object\nallOf: [{type: object}]\nrequired: [name]" -> "composition"
+  )
+
+  unsupported.foreach { case (schema, keyword) =>
+    test(s"3.1 reports unsupported $keyword instead of dropping it") {
+      val spec = document(
+        "Other: {type: string}\nValue:\n" + schema.linesIterator
+          .map("  " + _)
+          .mkString("\n")
+      )
+      OpenApiCompiler.compile(options, input(spec)) match {
+        case ToSmithyResult.Failure(error, errors) =>
+          assert(
+            (error :: errors).exists(_.toString.contains(keyword)),
+            (error :: errors).mkString("\n")
+          )
+        case other => fail(s"Expected an explicit restriction, got $other")
+      }
+    }
+  }
+
+  test("3.1 false schemas report a restriction") {
+    OpenApiCompiler.compile(
+      options,
+      input(
+        document("Holder:\n  type: object\n  properties:\n    never: false")
+      )
+    ) match {
+      case ToSmithyResult.Failure(error, errors) =>
+        assert((error :: errors).exists(_.toString.contains("false schemas")))
+      case other => fail(other.toString)
+    }
+  }
+
+  test("3.1 restrictions also remain visible in best-effort output") {
+    OpenApiCompiler.compile(
+      options.copy(validateOutput = false),
+      input(document("Value:\n  type: string\n  const: fixed"))
+    ) match {
+      case ToSmithyResult.Success(errors, model) =>
+        assert(errors.exists(_.toString.contains("const")))
+        assert(
+          model
+            .expectShape(ShapeId.from("error#Value"))
+            .hasTrait("smithytranslate#errorMessage")
+        )
+      case other => fail(other.toString)
+    }
+  }
+}
