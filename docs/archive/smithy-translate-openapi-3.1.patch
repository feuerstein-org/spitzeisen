+package smithytranslate.compiler.internals.openapi
+
+import io.swagger.v3.oas.models.SpecVersion
+import io.swagger.v3.oas.models.media.Schema
+import scala.jdk.CollectionConverters._
+
+private[openapi] object Schema31 {
+  private def validations(schema: Schema[_]): List[String] = List(
+    "type" -> SchemaType.types(schema).nonEmpty,
+    "enum" -> (schema.getEnum != null),
+    "properties" -> (schema.getProperties != null),
+    "required" -> (schema.getRequired != null),
+    "items" -> (schema.getItems != null),
+    "additionalProperties" -> (schema.getAdditionalProperties != null),
+    "allOf" -> (schema.getAllOf != null),
+    "oneOf" -> (schema.getOneOf != null),
+    "minimum" -> (schema.getMinimum != null),
+    "maximum" -> (schema.getMaximum != null),
+    "exclusiveMinimum" -> (schema.getExclusiveMinimumValue != null),
+    "exclusiveMaximum" -> (schema.getExclusiveMaximumValue != null),
+    "minLength" -> (schema.getMinLength != null),
+    "maxLength" -> (schema.getMaxLength != null),
+    "pattern" -> (schema.getPattern != null),
+    "minItems" -> (schema.getMinItems != null),
+    "maxItems" -> (schema.getMaxItems != null),
+    "uniqueItems" -> (schema.getUniqueItems != null)
+  ).collect { case (key, true) => key }
+
+  // Called only after restriction has checked unsupported keywords.
+  def isUnconstrained(schema: Schema[_]): Boolean =
+    schema.getSpecVersion == SpecVersion.V31 &&
+      schema.get$ref == null && validations(schema).isEmpty
+
+  def restriction(schema: Schema[_]): Option[String] = {
+    if (schema.getSpecVersion != SpecVersion.V31) None
+    else {
+      // Inspect Schema objects, never property names, examples, or extension data.
+      // A type match must not hide a JSON Schema constraint we cannot represent.
+      val unsupported = List(
+        "const" -> schema.getConst,
+        "not" -> schema.getNot,
+        "anyOf" -> schema.getAnyOf,
+        "if" -> schema.getIf,
+        "then" -> schema.getThen,
+        "else" -> schema.getElse,
+        "prefixItems" -> schema.getPrefixItems,
+        "contains" -> schema.getContains,
+        "minContains" -> schema.getMinContains,
+        "maxContains" -> schema.getMaxContains,
+        "unevaluatedItems" -> schema.getUnevaluatedItems,
+        "unevaluatedProperties" -> schema.getUnevaluatedProperties,
+        "additionalItems" -> schema.getAdditionalItems,
+        "dependentSchemas" -> schema.getDependentSchemas,
+        "dependentRequired" -> schema.getDependentRequired,
+        "patternProperties" -> schema.getPatternProperties,
+        "propertyNames" -> schema.getPropertyNames,
+        "multipleOf" -> schema.getMultipleOf,
+        "minProperties" -> schema.getMinProperties,
+        "maxProperties" -> schema.getMaxProperties,
+        "contentEncoding" -> schema.getContentEncoding,
+        "contentMediaType" -> schema.getContentMediaType,
+        "contentSchema" -> schema.getContentSchema,
+        "$id" -> schema.get$id,
+        "$anchor" -> schema.get$anchor,
+        "$dynamicAnchor" -> schema.get$dynamicAnchor,
+        "$vocabulary" -> schema.get$vocabulary
+      ).collect { case (key, value) if value != null => key }
+      val unknown = Option(schema.getExtensions).toList.flatMap(
+        _.keySet.asScala.filterNot(_.startsWith("x-"))
+      )
+      val types = SchemaType.types(schema)
+      val constraints = validations(schema)
+      val stringEnum = SchemaType.unapply(schema).contains("string") &&
+        Option(schema.getEnum).exists(values =>
+          values.asScala.exists(_.isInstanceOf[String]) &&
+            values.asScala.forall(v => v == null || v.isInstanceOf[String])
+        )
+
+      if (unsupported.nonEmpty || unknown.nonEmpty)
+        Some(
+          s"OpenAPI 3.1 schema keywords not supported: ${(unsupported ++ unknown).sorted.mkString(", ")}"
+        )
+      else if ((types - "null").size > 1)
+        Some(
+          s"OpenAPI 3.1 type unions other than a nullable type are not supported: ${types.toList.sorted.mkString(", ")}"
+        )
+      else if (schema.get$ref != null && constraints.nonEmpty)
+        Some(
+          s"OpenAPI 3.1 validation siblings of $$ref are not supported: ${constraints.mkString(", ")}"
+        )
+      else if (schema.getEnum != null && !stringEnum)
+        Some("OpenAPI 3.1 enum requires a string type and string values")
+      else if (
+        Option(schema.getBooleanSchemaValue).exists(b => !b.booleanValue())
+      )
+        Some("OpenAPI 3.1 false schemas cannot be represented in Smithy")
+      else if (schema.getAllOf != null || schema.getOneOf != null) {
+        val siblings = constraints.filterNot(k =>
+          k == "allOf" || k == "oneOf" || (k == "type" && types == Set(
+            "object"
+          ))
+        )
+        if (
+          siblings.nonEmpty || (schema.getAllOf != null && schema.getOneOf != null)
+        )
+          Some(
+            "OpenAPI 3.1 composition with sibling constraints is not supported"
+          )
+        else None
+      } else None
+    }
+  }
+}
